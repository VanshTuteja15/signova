# Copy this file to .env (which git ignores) and fill in what you need.
# Nothing here is required: without a key SIGNOVA uses the rule-based gloss.

# Claude API key for the "claude" gloss engine (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Claude model used for glossing (default: claude-haiku-4-5)
SIGNOVA_MODEL=claude-haiku-4-5

# faster-whisper model: base.en (fast, default) or small.en (more accurate)
SIGNOVA_WHISPER_MODEL=base.en

# Optional overrides
# SIGNOVA_HAND_CONFIG=config/hand.yaml
# SIGNOVA_LIBRARY=signs/library.yaml
# SIGNOVA_DATA_DIR=data
